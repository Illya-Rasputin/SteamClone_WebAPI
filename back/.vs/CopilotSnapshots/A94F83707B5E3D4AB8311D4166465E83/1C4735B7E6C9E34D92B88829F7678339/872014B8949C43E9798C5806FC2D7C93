using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using DAL.Entities;
using Microsoft.EntityFrameworkCore;

namespace DAL.Repositories
{
    public class GameImageRepository: GenericRepository<GameImageEntity>
    {
        private readonly AppDbContext _context;

        public GameImageRepository(AppDbContext context)
        {
            _context = context;
        }

        public IQueryable<GameImageEntity> GameImages => GetAll();

        public async Task<GameImageEntity?> GetByGameIdAsync(int id)
        {
            return await _context.GameImages
                .FirstOrDefaultAsync(image => image.GameId == id);
        }
    }
}
